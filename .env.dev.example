# Template for .env.dev — credentials for the shared develop cloud deployment
# (fortunate-retriever-189, dev.rngo.ro). Copy to .env.dev and fill in values.
# .env.local stays for personal local dev against your own Convex dev deployment.
#
# Used by: mise run convex:deploy-dev / convex:run-dev

# develop-scoped deploy key (same one stored in Vercel's Preview env)
CONVEX_DEPLOY_KEY=

NEXT_PUBLIC_CONVEX_URL=https://fortunate-retriever-189.convex.cloud
