{
  "name": "rentngo",
  "version": "2.4.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.x",
    "bun": ">=1"
  },
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents:check": "bun scripts/check-agent-setup.ts",
    "agents:link": "bun scripts/link-agent-files.ts",
    "agents:refresh-convex": "bun scripts/refresh-convex-ai.ts && bun run agents:link && bun run agents:check",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit --tsBuildInfoFile .tsgo-cache/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@convex-dev/resend": "^0.2.5",
    "@dnd-kit/core": "^6.3.1",
