{
  "name": "rentngo",
  "version": "2.4.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "bun": ">=1"
  },
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "agents:check": "bun scripts/check-agent-setup.ts",
    "agents:link": "bun scripts/link-agent-files.ts",
    "agents:refresh-convex": "bun scripts/refresh-convex-ai.ts && bun run agents:link && bun run agents:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.15",
